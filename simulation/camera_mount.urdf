<?xml version="1.0"?>
<robot name="gyro_camera_mount">
  <material name="base_gray"><color rgba="0.25 0.28 0.32 1"/></material>
  <material name="arm_blue"><color rgba="0.12 0.35 0.78 1"/></material>
  <material name="camera_black"><color rgba="0.04 0.04 0.05 1"/></material>

  <link name="base_link">
    <visual><origin xyz="0 0 0.06"/><geometry><cylinder radius="0.16" length="0.12"/></geometry><material name="base_gray"/></visual>
    <collision><origin xyz="0 0 0.06"/><geometry><cylinder radius="0.16" length="0.12"/></geometry></collision>
    <inertial><origin xyz="0 0 0.06"/><mass value="1.5"/><inertia ixx="0.012" ixy="0" ixz="0" iyy="0.012" iyz="0" izz="0.02"/></inertial>
  </link>

  <link name="yaw_link">
    <visual><origin xyz="0 0 0.13"/><geometry><cylinder radius="0.035" length="0.26"/></geometry><material name="arm_blue"/></visual>
    <inertial><origin xyz="0 0 0.13"/><mass value="0.3"/><inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.001"/></inertial>
  </link>
  <joint name="camera_yaw_joint" type="revolute">
    <parent link="base_link"/><child link="yaw_link"/><origin xyz="0 0 0.12"/>
    <axis xyz="0 0 1"/><limit lower="-1.4" upper="1.4" effort="8" velocity="2.0"/>
    <dynamics damping="0.4" friction="0.05"/>
  </joint>

  <link name="camera_pitch_link">
    <visual><origin xyz="0.10 0 0"/><geometry><box size="0.22 0.13 0.10"/></geometry><material name="arm_blue"/></visual>
    <collision><origin xyz="0.10 0 0"/><geometry><box size="0.22 0.13 0.10"/></geometry></collision>
    <inertial><origin xyz="0.10 0 0"/><mass value="0.35"/><inertia ixx="0.002" ixy="0" ixz="0" iyy="0.003" iyz="0" izz="0.003"/></inertial>
  </link>
  <joint name="camera_pitch_joint" type="revolute">
    <parent link="yaw_link"/><child link="camera_pitch_link"/><origin xyz="0 0 0.26"/>
    <axis xyz="0 1 0"/><limit lower="-1.0" upper="1.0" effort="8" velocity="2.0"/>
    <dynamics damping="0.4" friction="0.05"/>
  </joint>

  <link name="camera_link">
    <visual><origin xyz="0.22 0 0"/><geometry><box size="0.08 0.09 0.07"/></geometry><material name="camera_black"/></visual>
    <inertial><origin xyz="0.22 0 0"/><mass value="0.08"/><inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0002"/></inertial>
  </link>
  <joint name="camera_fixed_joint" type="fixed">
    <parent link="camera_pitch_link"/><child link="camera_link"/><origin xyz="0 0 0"/>
  </joint>

  <gazebo reference="camera_link">
    <sensor name="camera_sensor" type="camera">
      <always_on>true</always_on><update_rate>20</update_rate><visualize>true</visualize>
      <camera><horizontal_fov>1.047</horizontal_fov>
        <image><width>640</width><height>480</height><format>R8G8B8</format></image>
        <clip><near>0.05</near><far>15</far></clip>
      </camera>
      <plugin name="gazebo_ros_camera" filename="libgazebo_ros_camera.so">
        <ros><namespace>/camera</namespace></ros>
        <camera_name>camera</camera_name><frame_name>camera_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <ros2_control name="GazeboSystem" type="system">
    <hardware><plugin>gazebo_ros2_control/GazeboSystem</plugin></hardware>
    <joint name="camera_yaw_joint"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/></joint>
    <joint name="camera_pitch_joint"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/></joint>
  </ros2_control>
  <gazebo>
    <plugin name="gazebo_ros2_control" filename="libgazebo_ros2_control.so">
      <parameters>/tmp/gyro_camera_controllers.yaml</parameters>
    </plugin>
  </gazebo>
</robot>
