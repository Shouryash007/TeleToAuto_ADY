<?xml version="1.0" ?>
<sdf version="1.7">
  <world name="robot_interaction_world">

    <!-- Basic simulation environment -->
    <gravity>0 0 -9.81</gravity>

    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
      <ode>
        <solver>
          <type>quick</type>
          <iters>100</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>0.00001</cfm>
          <erp>0.2</erp>
        </constraints>
      </ode>
    </physics>

    <scene>
      <ambient>0.55 0.55 0.55 1</ambient>
      <background>0.75 0.80 0.88 1</background>
      <shadows>true</shadows>
    </scene>

    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Ground plane -->
    <model name="ground">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="ground_visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.72 0.72 0.72 1</ambient>
            <diffuse>0.72 0.72 0.72 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!--
      MESH DIRECTORY:
      /home/shourya007/teleToAuto_ADY/static/meshes/world_STL/

      These file:// URIs point to the STL files listed in the terminal.
      The mesh scale is 1.0. If the STL files were exported in millimetres,
      change the relevant scale to 0.001 0.001 0.001.
    -->

    <!-- Static table: mesh is used for both appearance and collision. -->
    <model name="table">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="table_link">
        <collision name="table_collision">
          <geometry>
            <mesh>
              <uri>file:///home/shourya007/teleToAuto_ADY/static/meshes/world_STL/Table.stl</uri>
              <scale>1 0.6 1</scale>
            </mesh>
          </geometry>
        </collision>
        <visual name="table_visual">
          <geometry>
            <mesh>
              <uri>file:///home/shourya007/teleToAuto_ADY/static/meshes/world_STL/Table.stl</uri>
              <scale>1 0.6 1</scale>
            </mesh>
          </geometry>
          <material>
            <ambient>0.48 0.31 0.18 1</ambient>
            <diffuse>0.62 0.43 0.27 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Static shelf: mesh is used for both appearance and collision. -->
    <model name="shelf">
      <static>true</static>
      <pose>0 1 0 0 0 1.57</pose>
      <link name="shelf_link">
        <collision name="shelf_collision">
          <geometry>
            <mesh>
              <uri>file:///home/shourya007/teleToAuto_ADY/static/meshes/world_STL/Shelf.stl</uri>
              <scale>0.2 0.2 0.2</scale>
            </mesh>
          </geometry>
        </collision>
        <visual name="shelf_visual">
          <geometry>
            <mesh>
              <uri>file:///home/shourya007/teleToAuto_ADY/static/meshes/world_STL/Shelf.stl</uri>
              <scale>0.2 0.2 0.2</scale>
            </mesh>
          </geometry>
          <material>
            <ambient>0.42 0.30 0.18 1</ambient>
            <diffuse>0.58 0.42 0.26 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!--
      Dynamic bottles:
      STL is used for visual appearance. A cylinder collision shape is used
      for stable grasp/contact physics. The dimensions below are starter
      values only: radius 0.035 m, height 0.24 m.
      Adjust them to the actual bottle dimensions after checking the STL.
    -->
    <model name="water_bottle_1">
      <static>false</static>
      <pose>0.20 0 0.87 0 0 0</pose>
      <link name="bottle_link">
        <gravity>true</gravity>
        <kinematic>false</kinematic>
        <inertial>
          <mass>0.18</mass>
          <inertia>
            <ixx>0.000919125</ixx>
            <iyy>0.000919125</iyy>
            <izz>0.00011025</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="bottle_collision">
          <pose>0 0 0.03 0 0 0</pose>
          <max_contacts>20</max_contacts>
          <geometry>
            <cylinder>
              <radius>0.02</radius>
              <length>0.07</length>
            </cylinder>
          </geometry>
          <surface>
            <friction>
              <ode><mu>2.0</mu><mu2>2.0</mu2></ode>
            </friction>
            <contact><ode><kp>100000</kp><kd>10</kd></ode></contact>
          </surface>
        </collision>
        <visual name="bottle_visual">
          <geometry>
            <mesh>
              <uri>file:///home/shourya007/teleToAuto_ADY/static/meshes/world_STL/water bottle 1.stl</uri>
              <scale>0.01 0.01 0.01</scale>
            </mesh>
          </geometry>
          <material>
            <ambient>0.15 0.48 0.85 1</ambient>
            <diffuse>0.20 0.62 0.95 1</diffuse>
            <specular>0.25 0.25 0.25 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="water_bottle_2">
      <static>false</static>
      <pose>0 0 0.87 0 0 0</pose>
      <link name="bottle_link">
        <gravity>true</gravity>
        <kinematic>false</kinematic>
        <inertial>
          <mass>0.18</mass>
          <inertia>
            <ixx>0.000919125</ixx>
            <iyy>0.000919125</iyy>
            <izz>0.00011025</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="bottle_collision">
          <pose>0.06 0 0.028 0 0 0</pose>
          <max_contacts>20</max_contacts>
          <geometry>
            <cylinder>
              <radius>0.018</radius>
              <length>0.07</length>
            </cylinder>
          </geometry>
          <surface>
            <friction>
              <ode><mu>2.0</mu><mu2>2.0</mu2></ode>
            </friction>
            <contact><ode><kp>100000</kp><kd>10</kd></ode></contact>
          </surface>
        </collision>
        <visual name="bottle_visual">
          <geometry>
            <mesh>
              <uri>file:///home/shourya007/teleToAuto_ADY/static/meshes/world_STL/water bottle 2.stl</uri>
              <scale>0.01 0.01 0.01</scale>
            </mesh>
          </geometry>
          <material>
            <ambient>0.20 0.72 0.55 1</ambient>
            <diffuse>0.25 0.85 0.62 1</diffuse>
            <specular>0.25 0.25 0.25 1</specular>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
