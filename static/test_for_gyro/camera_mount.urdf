<?xml version="1.0"?>
<robot name="abhi_camera">

  <link name="base_link">
    <!-- Temporary physically valid inertia for Gazebo Classic.
         Replace with CAD-derived mass/inertia when available. -->
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="2.0"/>
      <inertia ixx="0.02" ixy="0" ixz="0"
               iyy="0.02" iyz="0" izz="0.02"/>
    </inertial>

    <visual>
      <origin xyz="0.7 0.170034 -0.165" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file:///home/shourya007/teleToAuto_ADY/static/meshes/arm_stand_1.stl"
              scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="dark_grey">
        <color rgba="0.25 0.27 0.90 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0.7 0.170034 -0.165" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file:///home/shourya007/teleToAuto_ADY/static/meshes/arm_stand_1.stl"
              scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <link name="camer_z_stand_1">
    <inertial>
      <origin xyz="0 -0.0000169114 0.0770071" rpy="0 0 0"/>
      <mass value="0.90406499"/>
      <inertia ixx="0.002807" ixy="0" ixz="0"
               iyy="0.001761" iyz="0" izz="0.001131"/>
    </inertial>

    <visual>
      <origin xyz="0.7 0.170034 -0.765" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file:///home/shourya007/teleToAuto_ADY/static/meshes/camer_z_stand_1.stl"
              scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="orange">
        <color rgba="1.0 0.35 0.05 1"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0.7 0.170034 -0.765" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file:///home/shourya007/teleToAuto_ADY/static/meshes/camer_z_stand_1.stl"
              scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <link name="depth_camera_1">
    <inertial>
      <origin xyz="0 0.0599999 0" rpy="0 0 0"/>
      <mass value="0.71883075"/>
      <inertia ixx="0.000679" ixy="0" ixz="0"
               iyy="0.000106" iyz="0" izz="0.000679"/>
    </inertial>

    <visual>
      <origin xyz="0.7 0.230149 -0.92" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file:///home/shourya007/teleToAuto_ADY/static/meshes/depth_camera_1.stl"
              scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="camera_blue">
        <color rgba="0.05 0.35 0.85 1"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0.7 0.230149 -0.92" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file:///home/shourya007/teleToAuto_ADY/static/meshes/depth_camera_1.stl"
              scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <joint name="revolute_18" type="continuous">
    <origin xyz="0 0 0.6" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="camer_z_stand_1"/>
    <axis xyz="0 0 -1"/>
  </joint>

  <joint name="revolute_19" type="continuous">
    <origin xyz="0 -0.060115 0.155" rpy="0 0 0"/>
    <parent link="camer_z_stand_1"/>
    <child link="depth_camera_1"/>
    <axis xyz="0 1 0"/>
  </joint>

  <ros2_control name="AbhiCameraSystem" type="system">
    <hardware>
      <plugin>gazebo_ros2_control/GazeboSystem</plugin>
    </hardware>

    <joint name="revolute_18">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="revolute_19">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <gazebo>
    <plugin filename="libgazebo_ros2_control.so"
            name="gazebo_ros2_control">
        <parameters>/tmp/abhi_camera_controllers.yaml</parameters>
    </plugin>
  </gazebo>

  <gazebo reference="base_link">
    <material>Gazebo/DarkGrey</material>
  </gazebo>

  <gazebo reference="camer_z_stand_1">
    <material>Gazebo/Orange</material>
  </gazebo>

  <gazebo reference="depth_camera_1">
    <material>Gazebo/Blue</material>
  </gazebo>

</robot>