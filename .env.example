# ============================================================
# TeleToAuto_ADY - Environment Configuration Template
# ============================================================
# Copy this file to .env and adjust values for your environment.
# NEVER commit the actual .env file or real secrets to version control.

# ------------------------------------------------------------
# Robot Endpoint Configuration (robot/robot1.py)
# ------------------------------------------------------------
ROBOT_ID=robot_001
ROBOT_TOKEN=your_robot_secret_token_here
SIGNALING_SERVER=ws://127.0.0.1:8000/ws

# Video / Camera Stream Configuration
# Leave CAMERA_DEVICE empty to run dummy test video frames (ideal for headless servers or simulation)
# Set to an integer index (e.g., 0) or v4l2 device path (e.g., /dev/video0) for a physical USB camera
CAMERA_DEVICE=
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
CAMERA_FPS=30
ENABLE_PHYSICAL_CAMERA=false

# Simulation IPC (UDP bridge connecting robot endpoint to Gazebo node)
SIMULATION_ENABLED=true
SIMULATION_IPC_HOST=127.0.0.1
SIMULATION_IPC_PORT=8766
COMMAND_TIMEOUT_SECONDS=0.5
MAX_ABS_JOINT_DEG=180.0

# Optional WebRTC STUN / TURN NAT Traversal Servers
# STUN_URL=stun:stun.l.google.com:19302
# TURN_URL=turn:turn.example.com:3478
# TURN_USERNAME=your_turn_username
# TURN_PASSWORD=your_turn_password

# ------------------------------------------------------------
# Simulation Bridge Configuration (simulation/gazebo_joint_bridge.py)
# ------------------------------------------------------------
GAZEBO_TRAJECTORY_TOPIC=/joint_trajectory_controller/joint_trajectory
GAZEBO_JOINT_NAMES=left_shoulder_pan_joint,left_shoulder_lift_joint,left_elbow_flex_joint,left_wrist_flex_joint,left_wrist_roll_joint,right_shoulder_pan_joint,right_shoulder_lift_joint,right_elbow_flex_joint,right_wrist_flex_joint,right_wrist_roll_joint
LEFT_GRIPPER_JOINT=left_gripper_joint
RIGHT_GRIPPER_JOINT=right_gripper_joint
HEAD_YAW_JOINT=neck_yaw_joint
HEAD_PITCH_JOINT=neck_pitch_joint
GRIPPER_OPEN_POSITION=0.0
GRIPPER_CLOSED_POSITION=0.8
TRAJECTORY_DURATION=0.12

# ------------------------------------------------------------
# Hardware Follower Driver (Optional / Experimental)
# ------------------------------------------------------------
FOLLOWER_MOTION_ENABLED=false
